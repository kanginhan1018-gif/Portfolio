---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../site';
import { url } from '../lib/url';
// i18n: page offers the ko/en toggle; the inline script applies a stored choice before first paint.
const { title, description = SITE.tagline, i18n = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · {SITE.name}</title>
    {i18n && <script is:inline>(function(){var h=document.documentElement;h.dataset.js='';try{if(localStorage.getItem('lang')==='ko'){h.lang='ko';h.dataset.lang='ko'}}catch(e){}})()</script>}
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={url('/')}>{SITE.name}</a>
        <nav>
          <a href={url('/projects/')}>Projects</a>
          <a href={url('/papers/')}>Papers</a>
          <a href={url('/about/')}>About</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">© {new Date().getFullYear()} {SITE.name}</footer>
  </body>
</html>
