---
const breadth = ['Data analysis', 'Machine learning', 'Engineering', 'Communication'];
const depth = ['LP', 'MIP', 'Stochastic', 'Decomposition'];
---
<section class="tscroll" data-tscroll>
  <figure class="t" aria-label="T-shaped skill model: breadth across the top, depth in mathematical optimization">
    <div class="bar">
      <span class="tag">Breadth</span>
      <ul>{breadth.map((b, i) => <li class="b" style={`--i:${i}`}>{b}</li>)}</ul>
    </div>
    <div class="stem">
      <i class="fl"></i><i class="fr"></i>
      <div class="clip">
        <div class="body">
          <span class="tag">Depth</span>
          <strong>Mathematical optimization</strong>
          <ul>{depth.map((d, k) => <li class="d" style={`--k:${k}`}>{d}</li>)}</ul>
        </div>
      </div>
    </div>
  </figure>
</section>
<style>
  .tscroll { margin: 0; overflow-x: clip; }
  .t { margin: 0 auto; max-width: 640px; display: flex; flex-direction: column; align-items: center; }
  .bar { width: 100%; padding: 24px 20px 28px; border-radius: 28px; background: var(--surface); text-align: center; position: relative; z-index: 1; transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease; }
  .stem { position: relative; width: min(64%, 300px); display: grid; grid-template-rows: 1fr; margin-top: -1px; transition: grid-template-rows 1s cubic-bezier(0.65, 0, 0.35, 1) 1s; }
  .clip { min-height: 0; overflow: hidden; border-radius: 0 0 28px 28px; background: var(--accent); }
  .body { padding: 30px 18px 28px; text-align: center; color: #fff; transition: opacity 0.5s ease 1.7s; }
  /* concave fillets where the stem meets the bar */
  .fl, .fr { position: absolute; top: 0; width: 24px; height: 24px; transition: opacity 0.3s ease 1s; }
  .fl { left: -24px; background: radial-gradient(circle at 0 100%, transparent 23.5px, var(--surface) 24px); }
  .fr { right: -24px; background: radial-gradient(circle at 100% 100%, transparent 23.5px, var(--surface) 24px); }
  .tag { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; margin-bottom: 10px; }
  .body strong { display: block; font-size: 20px; line-height: 1.3; letter-spacing: -0.02em; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  li { font-size: 14px; font-weight: 600; padding: 5px 14px; border-radius: 999px; background: var(--bg); color: var(--fg); }
  .body li { background: rgba(255, 255, 255, 0.22); color: #fff; }
  li.b { transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.25s + var(--i) * 90ms), opacity 0.4s ease calc(0.25s + var(--i) * 90ms); }
  li.d { transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) calc(1.8s + var(--k) * 90ms), opacity 0.4s ease calc(1.8s + var(--k) * 90ms); }

  /* Start state: only when JS armed the animation and it has not played yet. */
  [data-live]:not(.play) .bar { opacity: 0; transform: translateY(28px) scale(0.96); }
  [data-live]:not(.play) li.b, [data-live]:not(.play) li.d { opacity: 0; transform: scale(0.5); }
  [data-live]:not(.play) .stem { grid-template-rows: 0fr; }
  [data-live]:not(.play) .fl, [data-live]:not(.play) .fr { opacity: 0; }
  [data-live]:not(.play) .body { opacity: 0; }
</style>
<script>
  const el = document.querySelector<HTMLElement>('[data-tscroll]');
  if (el && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    el.setAttribute('data-live', '');
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      requestAnimationFrame(() => el.classList.add('play'));
      io.disconnect();
    }, { threshold: 0.6 });
    io.observe(el);
  }
</script>
