---
const breadth = ['Data analysis', 'Machine learning', 'Engineering', 'Communication'];
const depth = ['LP', 'MIP', 'Stochastic', 'Decomposition'];
---
<figure class="t" aria-label="T-shaped skill model">
  <div class="bar">
    <span class="tag">Breadth</span>
    <ul>{breadth.map((b) => <li>{b}</li>)}</ul>
  </div>
  <div class="stem">
    <span class="tag">Depth</span>
    <strong>Mathematical optimization</strong>
    <ul>{depth.map((d) => <li>{d}</li>)}</ul>
  </div>
</figure>
<style>
  .t { margin: 32px 0; display: flex; flex-direction: column; align-items: center; }
  .bar, .stem {
    -webkit-backdrop-filter: blur(18px) saturate(160%); backdrop-filter: blur(18px) saturate(160%);
    box-shadow: var(--shadow), var(--inset); text-align: center;
  }
  .bar {
    width: 100%; padding: 14px 20px 18px; border-radius: 24px 24px 0 0;
    background: var(--glass); border: 1px solid var(--edge); border-bottom: 0;
  }
  .stem {
    width: min(60%, 300px); padding: 20px 16px 24px; border-radius: 0 0 24px 24px; margin-top: -1px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--accent) 80%, transparent), color-mix(in srgb, var(--accent2) 70%, transparent));
    border: 1px solid var(--edge); border-top: 0; color: #fff;
  }
  .tag { display: block; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; opacity: .7; margin-bottom: 8px; }
  .stem strong { display: block; font-size: 18px; line-height: 1.3; margin-bottom: 10px; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  li { font-size: 13px; padding: 3px 12px; border-radius: 999px; background: var(--glass-strong); border: 1px solid var(--edge); }
  .stem li { background: rgba(255, 255, 255, 0.2); }
</style>
