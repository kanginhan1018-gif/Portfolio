---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TShape from '../components/TShape.astro';
import { url } from '../lib/url';
const latest = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<Base title="Home">
  <section class="hero">
    <h1>Operations research,<br />grounded in <em>real data.</em></h1>
    <p class="lead">
      Deep in mathematical optimization, broad across data analysis, machine learning and engineering.
      Every project starts from a public dataset and ends with a model that makes a decision.
    </p>
  </section>
  <h2 class="section-title">Deep in one thing.<br />Broad around it.</h2>
  <TShape />
  <h2 class="section-title sm">Latest projects</h2>
  {latest.length === 0 ? <p class="muted">Coming soon.</p> : (
    <ul class="plain">
      {latest.map((p) => (
        <li class="card"><a href={url(`/projects/${p.id}/`)}>{p.data.title}</a>
          <span class="muted"> · {p.data.domain}</span></li>
      ))}
    </ul>
  )}
  <p><a href={url('/projects/')}>All projects →</a></p>
</Base>
